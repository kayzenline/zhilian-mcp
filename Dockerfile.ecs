# ECS production image: reuse shixiseng Playwright base to avoid OOM on 2GB Aliyun.
# Build: docker build -f Dockerfile.ecs -t zhilian-mcp:latest .
FROM shixiseng-mcp:latest
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/ /app/
ENV DATA_DIR=/data PORT=18064 TZ=Asia/Shanghai
VOLUME /data
EXPOSE 18064
CMD ["python","server.py"]
