[Unit]
Description=Cloudflare quick tunnel for zhilian-mcp
After=network-online.target caddy.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:18065
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
